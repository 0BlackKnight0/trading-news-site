SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
NEWSAPI_KEY=your-newsapi-key
TELEGRAM_BOT_TOKEN=your-bot-token

# Random string, 16+ chars. Vercel sends it as `Authorization: Bearer <value>`
# on cron invocations; /cron/daily rejects requests without it.
CRON_SECRET=generate-a-random-string

# Optional. If set, pass the same value as `secret_token` to Telegram's
# setWebhook so /telegram/webhook can verify inbound updates.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated allowed origins. Defaults to * — set it to your Vercel
# frontend URL once deployed.
CORS_ORIGINS=*

TZ=Asia/Kolkata
